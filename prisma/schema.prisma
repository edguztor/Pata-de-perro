generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Bed {
  id            Int           @id @default(autoincrement())
  number        Int
  name          String
  type          String        @default("DORM")
  position      String        @default("BOTTOM")
  bunkNumber    Int?
  floor         Int
  room          Int
  roomName      String
  pricePerNight Float         @default(200)
  reservations  Reservation[]
  createdAt     DateTime      @default(now())
}

model Guest {
  id           Int           @id @default(autoincrement())
  name         String
  email        String?
  phone        String?
  nationality  String?
  idNumber     String?
  reservations Reservation[]
  createdAt    DateTime      @default(now())
}

model Reservation {
  id            Int      @id @default(autoincrement())
  guest         Guest    @relation(fields: [guestId], references: [id])
  guestId       Int
  bed           Bed      @relation(fields: [bedId], references: [id])
  bedId         Int
  checkIn       DateTime
  checkOut      DateTime
  status        String   @default("RESERVED")
  totalAmount   Float
  pricePerNight Float
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  name         String
  passwordHash String
  role         String   @default("RECEPTIONIST")
  createdAt    DateTime @default(now())
}
